# =====================================================================
# sources.yaml : registre des sources de donnees (Phase 0)
# Especes : mais, riz, tabac
# Rempli le 2026-10-08. AUCUNE URL ni licence ci-dessous n'a encore ete
# verifiee : tout est marque `status: to_verify` et `license_checked: false`.
# Regle : un telechargement n'est autorise que si license_checked: true
# (voir validate_sources.py).
# =====================================================================

schema_version: 1

constraints:
  free_disk_gb_measured: 22        # 23 957 151 744 octets libres, 2026-10-09
  ram_gb: 8
  rule: "pas de fichiers globaux (UniProt/GOA complets) ; budget brut cible <= 12 Go"

legend:
  status: [to_verify, verified, blocked]          # etat de l'URL / du chemin
  redistribution: [open, private_only, unknown]    # peut-on republier (HF public, Zenodo) ?
  license_expected: "ce que je pense etre la licence, A CONFIRMER sur le site"
  phase: "phase du plan de collecte ou la source sert"

# ---------------------------------------------------------------------
# Politique d'identifiants (ID maitre)
# ---------------------------------------------------------------------
id_policy:
  master_id_format: "<ESPECE>|<assemblage>|<id_natif>"
  examples:
    - "NITAB|TN90_RefSeq|GeneID:107821857"
    - "NITAB|Nitab4.5|Nitab4.5_0000001g0010"
    - "ZEAMA|B73_v5_eb.1|Zm00001eb000010"
    - "ORYSA|IRGSP-1.0_RAP|Os01g0100100"
  rules:
    - "jamais de fusion par symbole"
    - "chaque enregistrement porte taxon_id + version d'assemblage + source"
    - "un lien non clair est classe `ambigu` ou `non_mappe`, jamais force"

mapping_rules:        # seuils PROPOSES, a figer apres le pilote (phase 4a)
  status: proposed
  categories: [exact, rbh_1to1, one_to_many, many_to_one, ambiguous, unmapped]
  tn90_vs_nitab45:
    method: "hash exact, puis meilleur hit reciproque (RBH), puis coordonnees des CDS (homeologues)"
    min_identity_pct: 95
    min_coverage_pct: 90
  rap_vs_msu:
    method: "table RAP-DB d'abord ; le reste par RBH sur les proteines"

release_policy:
  public_dataset_includes: "uniquement les sources avec license_checked: true ET redistribution: open"
  everything_else: "non republie : seuls les scripts de recuperation et le manifeste sont publies"
  required_in_release: [manifest.csv, rapport de completude, sources.yaml, species.yaml, citations]
  versioning: "version de la base = date + hash du manifeste"

training_corpora:                 # donnees d'entrainement, separees de la base de requete
  esm2_protein:
    data: "proteomes de plantes (UniProt + RefSeq), multi-especes : plus d'especes = mieux"
    labels: "GO non-IEA, domaines InterPro"
    split: "par cluster de sequences (MMseqs2 ou CD-HIT), jamais aleatoire"
    where_to_train: "Colab/Kaggle (GPU), donnees sur Hugging Face"
  agront_dna:
    data: "genomes + GFF (fichiers `optional` a activer dans fetch_raw), fenetres <= 6 144 nt"
    labels: "a definir (promoteurs, sites d'epissage, expression)"
    disk: "genomes = plusieurs Go : stockage externe ou Hugging Face"

# Les especes sont definies dans species.yaml (source de verite unique).

# ---------------------------------------------------------------------
# Sources
# ---------------------------------------------------------------------
sources:

